# ==============================================================================
# PokéEngine — Variables de Entorno y Configuración de API
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto:
#   cp .env.example .env
# NUNCA subas tu archivo `.env` al repositorio de Git.

# URL base oficial de la PokéAPI v2 (Pública y Gratuita)
VITE_POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# NOTA SOBRE CREDENCIALES:
# PokéAPI (https://pokeapi.co) es un proyecto colaborativo libre y gratuito.
# NO requiere registro ni clave de API.
#
# BUENAS PRÁCTICAS:
# La aplicación implementa un sistema interno de caché LRU (Least Recently Used)
# en memoria para minimizar peticiones redundantes y respetar la cuota comunitaria de la API.
